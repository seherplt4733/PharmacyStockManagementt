@model IEnumerable<PharmacyStock.DTO.PurchaseOrderDTO.PurchaseOrderListDto>
@using PharmacyStock.Entities.Enum
@using System.Linq

@section Styles {
    <link rel="stylesheet"
          href="~/css/purchase-order.css"
          asp-append-version="true" />
}


@{
    ViewData["Title"] = "Sipariş Takibi & Geçmişi";

    var orders = Model ?? Enumerable.Empty<PharmacyStock.DTO.PurchaseOrderDTO.PurchaseOrderListDto>();

    var totalOrders = orders.Count();

    var pendingOrders =
        orders.Count(x => x.Status == OrderStatus.Ordered);

    var completedOrders =
        orders.Count(x => x.Status == OrderStatus.Delivered);
}

<div class="container-fluid mt-4">

    <!-- =====================================================
         BAŞLIK
    ====================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-truck me-2"></i>

                Sipariş Geçmişi & Takibi

            </h3>

            <p class="text-muted small mb-0">

                Tedarikçilere verilen siparişlerin durumunu izleyin
                ve stoklarınıza aktarın.

            </p>

        </div>

    </div>


    <!-- =====================================================
         BAŞARI MESAJI
    ====================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>

        </div>
    }


    <!-- =====================================================
         KPI KARTLARI
    ====================================================== -->
    <!-- =====================================================
     KPI KARTLARI
====================================================== -->

    <div class="row g-3 mb-4">

        <!-- TOPLAM SİPARİŞ -->
        <div class="col-md-4">
            <div class="card purchase-card purchase-card-total h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="purchase-card-label">
                            Toplam Sipariş
                        </div>

                        <div class="purchase-card-value">
                            @totalOrders
                        </div>
                    </div>

                    <div class="purchase-card-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                </div>
            </div>
        </div>


        <!-- BEKLEYEN SİPARİŞLER -->
        <div class="col-md-4">
            <div class="card purchase-card purchase-card-pending h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="purchase-card-label">
                            Bekleyen Siparişler
                        </div>

                        <div class="purchase-card-value">
                            @pendingOrders
                        </div>
                    </div>

                    <div class="purchase-card-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                </div>
            </div>
        </div>


        <!-- TAMAMLANAN SİPARİŞLER -->
        <div class="col-md-4">
            <div class="card purchase-card purchase-card-completed h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="purchase-card-label">
                            Tamamlanan Siparişler
                        </div>

                        <div class="purchase-card-value">
                            @completedOrders
                        </div>
                    </div>

                    <div class="purchase-card-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- =====================================================
         ARAMA VE FİLTRE
    ====================================================== -->

    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-3">

            <div class="row g-3 align-items-center justify-content-between">

                <div class="col-md-5">

                    <div class="input-group">

                        <span class="input-group-text bg-transparent border-end-0">

                            <i class="bi bi-search text-muted"></i>

                        </span>

                        <input type="text"
                               id="orderSearchInput"
                               class="form-control border-start-0"
                               placeholder="Sipariş kodu veya tedarikçi ara..."
                               autocomplete="off" />

                    </div>

                </div>


                <div class="col-md-7 d-flex justify-content-md-end gap-2">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm filter-btn active"
                            data-filter="all">

                        Tümü (@totalOrders)

                    </button>

                    <button type="button"
                            class="btn btn-outline-warning btn-sm filter-btn"
                            data-filter="Ordered">

                        Bekleyenler (@pendingOrders)

                    </button>

                    <button type="button"
                            class="btn btn-outline-success btn-sm filter-btn"
                            data-filter="Delivered">

                        Tamamlananlar (@completedOrders)

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SİPARİŞ TABLOSU
    ====================================================== -->

    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="ordersTable">

                    <thead class="table-dark">

                        <tr>

                            <th class="ps-3">
                                Sipariş Kod
                            </th>

                            <th>
                                Tedarikçi
                            </th>

                            <th>
                                Sipariş Tarihi
                            </th>

                            <th>
                                Teslim Tarihi
                            </th>

                            <th>
                                Durum
                            </th>

                            <th class="text-end pe-3">
                                İşlemler
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var order in orders)
                        {
                            <tr class="order-row"
                                data-status="@order.Status">

                                <!-- SİPARİŞ KODU -->

                                <td class="ps-3 fw-semibold">

                                    <code>
                                        @order.OrderCode
                                    </code>

                                </td>


                                <!-- TEDARİKÇİ -->

                                <td>

                                    @(!string.IsNullOrWhiteSpace(order.SupplierName)
                                        ? order.SupplierName
                                        : "Tedarikçi")

                                </td>


                                <!-- SİPARİŞ TARİHİ -->

                                <td>

                                    @order.OrderDate.ToString("dd.MM.yyyy HH:mm")

                                </td>


                                <!-- TESLİM TARİHİ -->

                                <td>

                                    @if (order.DeliveryDate.HasValue)
                                    {
                                        <span>
                                            @order.DeliveryDate.Value.ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary opacity-75">
                                            Beklemede
                                        </span>
                                    }

                                </td>


                                <!-- DURUM -->

                                <td>

                                    @if (order.Status == OrderStatus.Ordered)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">

                                            <i class="bi bi-clock me-1"></i>

                                            Sipariş Verildi

                                        </span>
                                    }
                                    else if (order.Status == OrderStatus.Delivered)
                                    {
                                        <span class="badge bg-success px-2 py-1">

                                            <i class="bi bi-check-all me-1"></i>

                                            Teslim Alındı (Stok Güncellendi)

                                        </span>
                                    }
                                    else if (order.Status == OrderStatus.Cancelled)
                                    {
                                        <span class="badge bg-danger px-2 py-1">

                                            <i class="bi bi-x-circle me-1"></i>

                                            İptal Edildi

                                        </span>
                                    }

                                </td>


                                <!-- İŞLEMLER -->

                                <td class="text-end pe-3">

                                    <div class="d-inline-flex gap-2">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-info"
                                                data-bs-toggle="modal"
                                                data-bs-target="#orderDetailModal-@order.Id">

                                            <i class="bi bi-eye me-1"></i>

                                            Detay

                                        </button>


                                        @if (order.Status == OrderStatus.Ordered)
                                        {
                                            <form asp-action="UpdateStatus"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@order.Id" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="@OrderStatus.Delivered" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">

                                                    <i class="bi bi-box-seam me-1"></i>

                                                    Teslim Al (Stoklara Ekle)

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-secondary opacity-50"
                                                    disabled>

                                                Tamamlandı

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     SİPARİŞ DETAY MODALLARI
====================================================== -->
@foreach (var order in orders)
{
    <div class="modal fade"
         id="orderDetailModal-@order.Id"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="bi bi-receipt me-2"></i>

                        Sipariş Detayı: @order.OrderCode

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Kapat">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="row mb-3">

                        <div class="col-md-6">

                            <p class="mb-1 text-muted small">
                                Tedarikçi
                            </p>

                            <h6 class="fw-bold">

                                @(!string.IsNullOrWhiteSpace(order.SupplierName)
                                    ? order.SupplierName
                                    : "Belirtilmedi")

                            </h6>

                        </div>


                        <div class="col-md-6 text-md-end">

                            <p class="mb-1 text-muted small">
                                Sipariş Tarihi
                            </p>

                            <h6 class="fw-bold">

                                @order.OrderDate.ToString("dd.MM.yyyy HH:mm")

                            </h6>

                        </div>

                    </div>


                    <!-- ÜRÜNLER -->

                    <div class="table-responsive">

                        <table class="table table-bordered table-sm align-middle mb-0">

                            <thead>

                                <tr>

                                    <th>
                                        Ürün Adı
                                    </th>

                                    <th class="text-center">
                                        Miktar
                                    </th>

                                    <th class="text-end">
                                        Birim Fiyat
                                    </th>

                                    <th class="text-end">
                                        Toplam
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (order.OrderItems != null &&
                                     order.OrderItems.Any())
                                {
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <tr>

                                            <td>

                                                @(string.IsNullOrWhiteSpace(item.ProductName)
                                                    ? "Ürün"
                                                    : item.ProductName)

                                            </td>

                                            <td class="text-center">

                                                @item.Quantity Adet

                                            </td>

                                            <td class="text-end">

                                                ₺@item.UnitPrice.ToString("N2")

                                            </td>

                                            <td class="text-end fw-bold">

                                                ₺@((item.Quantity * item.UnitPrice).ToString("N2"))

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="4"
                                            class="text-center text-muted py-3">

                                            Bu siparişe ait ürün detayı bulunamadı.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            data-bs-dismiss="modal">

                        Kapat

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script src="~/js/purchase-order.js"
            asp-append-version="true">
    </script>

 
 

}