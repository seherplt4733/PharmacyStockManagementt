@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="account-wrapper">

    <div class="right-side" style="margin:auto;">

        <h2 class="form-title">Şifremi Unuttum</h2>

        <p class="text-secondary mb-4">
            Hesabınıza ait e-posta adresini girin.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        <form asp-action="ForgotPassword"
              asp-controller="Account"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-field-group">

                <label class="custom-label">
                    E-posta Adresi
                </label>

                <div class="custom-input-box">

                    <i class="bi bi-envelope input-icon"></i>

                    <input type="email"
                           name="email"
                           class="custom-input"
                           placeholder="ornek@email.com"
                           required />

                </div>

            </div>

            <button type="submit"
                    class="btn-glow-login">

                <i class="bi bi-arrow-right-circle"></i>

                <span>Devam Et</span>

            </button>

        </form>

        <div class="register-footer">

            <a asp-controller="Account"
               asp-action="Login"
               class="register-btn-modern">

                <i class="bi bi-arrow-left"></i>

                <span>Giriş Ekranına Dön</span>

            </a>

        </div>

    </div>

</div>