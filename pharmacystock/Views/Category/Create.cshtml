@model PharmacyStock.DTO.CategoryDTO.CategoryCreateDto

@{
    ViewData["Title"] = "Yeni Kategori";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/category-create.css"
          asp-append-version="true" />
}

<div class="container-fluid py-3">

    <!-- ANA KART -->
    <div class="card page-card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <!-- ÜST BAŞLIK VE BUTON -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

                <div class="d-flex align-items-center gap-2">

                    <span class="fs-4 text-warning">🏷️</span>

                    <h3 class="fw-bold mb-0 page-title-text">
                        Yeni Kategori
                    </h3>

                </div>

                <a asp-action="Index"
                   class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3">

                    <i class="bi bi-arrow-left"></i>

                    Listeye Dön

                </a>

            </div>


            <!-- FORM -->
            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- KATEGORİ ADI -->
                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-bold form-label-custom">

                        Kategori Adı

                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="Name"
                           class="form-control form-control-custom"
                           placeholder="Kategori adını giriniz..."
                           autocomplete="off" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>

                </div>


                <!-- AÇIKLAMA -->
                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label fw-bold form-label-custom">

                        Açıklama

                    </label>

                    <textarea asp-for="Description"
                              class="form-control form-control-custom"
                              rows="4"
                              placeholder="Kategori hakkında kısa açıklama yazınız..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger small">
                    </span>

                </div>


                <!-- BUTONLAR -->
                <div class="d-flex justify-content-end gap-2 pt-2">

                    <a asp-action="Index"
                       class="btn btn-secondary d-inline-flex align-items-center gap-1 rounded-2 px-4">

                        <i class="bi bi-x-lg"></i>

                        İptal

                    </a>

                    <button type="submit"
                            class="btn btn-primary d-inline-flex align-items-center gap-1 rounded-2 px-4 shadow-sm">

                        <i class="bi bi-check-lg"></i>

                        Kaydet

                    </button>

                </div>

            </form>

        </div>
    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

