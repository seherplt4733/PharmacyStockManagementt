@model IEnumerable<PharmacyStock.DTO.ProductDTO.ProductListDto>

@{
    ViewData["Title"] = "SKT Geçmiş Ürünler";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/product-expired.css"
          asp-append-version="true" />
}

<div class="container-fluid py-3">

    <!-- ANA KART -->
    <div class="card page-card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <!-- ÜST BAŞLIK VE BUTON -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-danger">🗓️</span>

                    <h3 class="fw-bold mb-0 page-title-text">
                        Son Kullanma Tarihi Geçmiş Ürünler
                    </h3>

                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 ms-2">
                        @Model.Count() Ürün
                    </span>
                </div>

                <a asp-action="Index"
                   class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3">
                    <i class="bi bi-arrow-left"></i>
                    Ürün Listesi
                </a>
            </div>

            <!-- İÇERİK -->
            @if (!Model.Any())
            {
                <div class="alert custom-alert-success d-flex align-items-center gap-2 p-3 rounded-3 mb-0">
                    <i class="bi bi-check-circle-fill fs-5"></i>

                    <div>
                        Sistemde son kullanma tarihi geçmiş herhangi bir ürün bulunmuyor.
                    </div>
                </div>
            }
            else
            {
                <!-- UYARI -->
                <div class="alert custom-alert-danger d-flex align-items-center gap-2 p-3 rounded-3 mb-4">
                    <i class="bi bi-exclamation-octagon-fill fs-5 flex-shrink-0"></i>

                    <div>
                        <strong>UYARI:</strong>
                        Aşağıdaki ürünlerin son kullanma tarihi geçmiştir.
                        Lütfen inceleyip stoktan düşüş işlemlerini gerçekleştirin.
                    </div>
                </div>

                <!-- TABLO -->
                <div class="table-responsive">

                    <table class="table table-custom align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Ürün Adı</th>
                                <th>Kategori</th>
                                <th>Marka</th>
                                <th class="text-center">Mevcut Stok</th>
                                <th class="text-center">SKT</th>
                                <th class="text-center">Geçen Süre</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                var daysOverdue =
                                    (DateTime.Today - item.ExpirationDate.Date).Days;

                                <tr>

                                    <!-- ÜRÜN -->
                                    <td class="fw-semibold text-main">
                                        @item.Name
                                    </td>

                                    <!-- KATEGORİ -->
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.CategoryName)
                                            ? "-"
                                            : item.CategoryName)
                                    </td>

                                    <!-- MARKA -->
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.BrandName)
                                            ? "-"
                                            : item.BrandName)
                                    </td>

                                    <!-- STOK -->
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-body fw-bold px-3 py-2 rounded-2">
                                            @item.CurrentStock
                                        </span>
                                    </td>

                                    <!-- SKT -->
                                    <td class="text-center fw-medium">
                                        @item.ExpirationDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <!-- GEÇEN SÜRE -->
                                    <td class="text-center">
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-2 fw-semibold">
                                            <i class="bi bi-clock-history me-1"></i>
                                            @daysOverdue Gün Geçti
                                        </span>
                                    </td>

                                    <!-- İŞLEM -->
                                    <td class="text-end">

                                        @if (item.CurrentStock > 0)
                                        {
                                            <a asp-controller="StockTransaction"
                                               asp-action="Create"
                                               asp-route-productId="@item.Id"
                                               asp-route-type="Out"
                                               class="btn btn-sm btn-outline-danger rounded-2 d-inline-flex align-items-center gap-1 shadow-sm">

                                                <i class="bi bi-box-arrow-up"></i>

                                                Fire Çıkışı Yap

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1 rounded-2">
                                                Stoksuz
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>
