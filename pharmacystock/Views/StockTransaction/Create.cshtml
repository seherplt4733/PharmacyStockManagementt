@model PharmacyStock.DTO.StockTransactionDTO.StockTransactionCreateDto

@using PharmacyStock.Entities.Enum

@{
    ViewData["Title"] = "Yeni Stok Hareketi";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/stock-transaction-create.css"
          asp-append-version="true" />
}

<div class="container-fluid py-4">

    <div class="card form-card shadow-sm border-0 rounded-3 max-width-800 mx-auto">
        <div class="card-body p-4">

            <!-- BAŞLIK -->
            <div class="d-flex align-items-center gap-2 mb-4">

                <i class="bi bi-plus-circle-fill fs-3 text-primary"></i>

                <h3 class="fw-bold mb-0 form-title-text">
                    Yeni Stok Hareketi Ekle
                </h3>

            </div>


            <!-- FORM -->
            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- ÜRÜN -->
                    <div class="col-md-6">

                        <label asp-for="ProductId"
                               class="form-label fw-semibold">
                            Ürün
                        </label>

                        <select asp-for="ProductId"
                                class="form-select custom-input"
                                asp-items="ViewBag.Products">

                            <option value="">
                                -- Ürün Seçin --
                            </option>

                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- İŞLEM TÜRÜ -->
                    <div class="col-md-6">

                        <label asp-for="Type"
                               class="form-label fw-semibold">
                            İşlem Türü
                        </label>

                        <select asp-for="Type"
                                class="form-select custom-input"
                                asp-items="Html.GetEnumSelectList<TransactionType>()">
                        </select>

                        <span asp-validation-for="Type"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- MİKTAR -->
                    <div class="col-md-6">

                        <label asp-for="Quantity"
                               class="form-label fw-semibold">
                            Miktar
                        </label>

                        <input asp-for="Quantity"
                               class="form-control custom-input"
                               type="number"
                               min="1"
                               placeholder="Miktar giriniz" />

                        <span asp-validation-for="Quantity"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- İŞLEM TARİHİ -->
                    <div class="col-md-6">

                        <label asp-for="TransactionDate"
                               class="form-label fw-semibold">
                            İşlem Tarihi
                        </label>

                        <input asp-for="TransactionDate"
                               class="form-control custom-input"
                               type="datetime-local" />

                        <span asp-validation-for="TransactionDate"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- İŞLEMİ YAPAN -->
                    <div class="col-12">

                        <label asp-for="PerformedBy"
                               class="form-label fw-semibold">
                            İşlemi Yapan
                        </label>

                        <input asp-for="PerformedBy"
                               class="form-control custom-input"
                               placeholder="İşlemi gerçekleştiren kişinin adı" />

                        <span asp-validation-for="PerformedBy"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- PARTİ / LOT NUMARASI -->
                    <div class="col-12">

                        <label asp-for="SerialNumbers"
                               class="form-label fw-semibold">
                            Parti / Lot Numarası
                        </label>

                        <input asp-for="SerialNumbers"
                               class="form-control custom-input"
                               type="text"
                               maxlength="30"
                               placeholder="Örn: LOT-2026-001" />

                        <span asp-validation-for="SerialNumbers"
                              class="text-danger small">
                        </span>

                        <small class="text-muted">
                            Harf, rakam ve "-" karakteri kullanabilirsiniz.
                        </small>

                    </div>


                    <!-- NOTLAR -->
                    <div class="col-12">

                        <label asp-for="Notes"
                               class="form-label fw-semibold">
                            Notlar / Açıklama
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control custom-input"
                                  rows="2"
                                  placeholder="Varsa ek notlar..."></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- BUTONLAR -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top custom-border">

                    <a asp-action="Recent"
                       class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-4">

                        <i class="bi bi-arrow-left"></i>

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="btn btn-success d-inline-flex align-items-center gap-2 shadow-sm px-4 fw-semibold">

                        <i class="bi bi-check-lg"></i>

                        Kaydet

                    </button>

                </div>

            </form>

        </div>
    </div>

</div>





@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}